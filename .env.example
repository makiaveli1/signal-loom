# Signal Loom talks to a local Hermes runtime. Do not commit real secrets.

# Hermes API server used by server-side routes and client-visible status copy.
NEXT_PUBLIC_HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_URL=http://127.0.0.1:8642

# Optional local API token. Prefer setting this in your shell or secret manager.
HERMES_API_KEY=
API_SERVER_KEY=

# Optional Hermes path overrides. Leave blank for ~/.hermes defaults.
HERMES_HOME=
HERMES_CONFIG=
HERMES_ENV=
HERMES_STATE_DB=
HERMES_RUNTIME_EVENTS_PATH=
HERMES_MEDIA_DIR=

# Local development/demo flags.
NEXT_PUBLIC_USE_MOCK_DATA=false
SIGNAL_LOOM_ENABLE_INSTALL=false
SIGNAL_LOOM_OPERATOR_TOKEN=
